<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS Discovery Server Profile
  Restringe o servidor a escutar apenas em:
    - 127.0.0.1   : clientes locais (camera nodes)
    - 100.107.134.30 : Netbird VPN (notebook remoto)

  IMPORTANTE: Sem esta restrição, o discovery server binda sockets em
  TODAS as interfaces, incluindo as GigE das câmeras (169.254.x.x),
  o que bloqueia o protocolo GVCP do ArenaSDK e impede a conexão.

  === CARRO ===
  Substituir 100.107.134.30 pelo IP da LAN do carro.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>restricted_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
        <address>100.107.134.30</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>restricted_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
