<?xml version="1.0" encoding="UTF-8" ?>
<!--
  FastDDS Discovery Server Profile
  Restringe o servidor a escutar apenas em 127.0.0.1 (clientes locais).
  Para acesso remoto, adicione o IP da interface VPN/LAN deste host como
  um segundo <address> na interfaceWhiteList e defina DISCOVERY_SERVER_IP
  no .env com o mesmo IP.

  IMPORTANTE: Sem esta restrição, o discovery server binda sockets em
  TODAS as interfaces, incluindo as GigE das câmeras (169.254.x.x),
  o que bloqueia o protocolo GVCP do ArenaSDK e impede a conexão.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>restricted_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>restricted_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
