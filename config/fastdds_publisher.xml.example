<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profile for the publisher (camera machine).
     Copy to fastdds_publisher.xml and replace YOUR.PUBLISHER.IP with the
     IP of the network interface used for streaming (e.g., WiFi or LAN).
     Or generate automatically: ./config/setup_fastdds.sh publisher <interface>

     This profile announces two locators:
       - 127.0.0.1 (loopback): for co-located subscribers on the same machine
         (e.g., the compression relay), enabling full-speed local DDS without
         routing raw camera data over a physical interface.
       - YOUR.PUBLISHER.IP (network): for remote subscribers on other machines.

     This prevents other interfaces (e.g., GigE camera port at 169.254.x.x)
     from being advertised as data locators to subscribers.
     Multicast discovery (239.255.0.1) is preserved (no <builtin> block).
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <participant profile_name="default_participant" is_default_profile="true">
    <rtps>
      <defaultUnicastLocatorList>
        <!-- Loopback for local subscribers on the same machine -->
        <locator>
          <udpv4>
            <address>127.0.0.1</address>
            <port>0</port>
          </udpv4>
        </locator>
        <!-- Network interface for remote subscribers -->
        <locator>
          <udpv4>
            <address>YOUR.PUBLISHER.IP</address>
            <port>0</port>
          </udpv4>
        </locator>
      </defaultUnicastLocatorList>
    </rtps>
  </participant>
</profiles>
