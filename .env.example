# ============================================================================
# lucid_camera_ros2 — Configuração de ambiente
# ============================================================================
# Copie para .env e ajuste os valores:
#   cp .env.example .env
#
# === SETUP COMPLETO ===
#
# 1) TRANSMISSOR (PC com câmeras):
#    - Conecte as câmeras GigE nos adaptadores USB/portas Ethernet
#    - Gere o profile FastDDS para a interface VPN/LAN:
#        ./config/setup_fastdds.sh publisher wt0        # VPN Netbird
#        ./config/setup_fastdds.sh publisher eth0       # LAN direta (carro)
#    - Ajuste o .env (copie deste arquivo)
#    - Suba os containers:
#        docker compose up -d
#    - Verifique nos logs:
#        docker compose logs -f camera_dev
#
# 2) RECEPTOR (notebook/PC remoto):
#    - Gere o profile FastDDS para sua interface:
#        ./config/setup_fastdds.sh subscriber wt0       # VPN Netbird
#        ./config/setup_fastdds.sh subscriber eth0      # LAN direta (carro)
#    - Configure o ambiente ROS2:
#        source /opt/ros/humble/setup.bash
#        export ROS_DISCOVERY_SERVER=<IP_TRANSMISSOR>:11811
#        export ROS_SUPER_CLIENT=true
#        export ROS_DOMAIN_ID=0
#        export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
#        export FASTRTPS_DEFAULT_PROFILES_FILE=<path>/config/fastdds_subscriber.xml
#        ros2 daemon stop
#    - Visualize (escolha uma opção):
#        python3 notebook_setup/stream_viewer.py --topic /camera_1/image_new --compressed
#        ros2 topic echo /camera_1/image_new/compressed sensor_msgs/msg/CompressedImage --no-daemon
#        ros2 topic list --no-daemon
#
# IMPORTANTE:
#   - Sempre use --no-daemon nos comandos ros2 (daemon incompatível com Discovery Server)
#   - Os profiles fastdds_publisher.xml e fastdds_subscriber.xml são gerados localmente
#     e não devem ser commitados (estão no .gitignore)
#
# ============================================================================

# === Build ===
ARENASDK_ROOT_ON_HOST=./resources/ArenaSDK/linux64
ARENASDK_PARENT=/
ARENA_API_ROOT_ON_HOST=./resources/arena_api
ARENA_API_PARENT=/arena_api

# === Câmeras ===
# Setup completo por câmera (serial, ip, iface, resolução, compressão):
#   ros2_ws/src/arena_camera_node/config/cameras.yaml
# Override opcional de serial sem editar o yaml:
# CAMERA_1_SERIAL=

# === Display (para visualização local com X11) ===
DISPLAY=:0
QT_X11_NO_MITSHM=1

# === ROS2 / FastDDS — Discovery Server ===
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_SUPER_CLIENT=true
# Endereço do Discovery Server visto pelos clientes (IP VPN ou LAN + porta).
# Local-only por padrão; para acesso remoto use o IP deste host na VPN/LAN.
ROS_DISCOVERY_SERVER=127.0.0.1:11811
# IP em que o Discovery Server escuta (mesmo IP acima, sem porta)
DISCOVERY_SERVER_IP=127.0.0.1
# FASTRTPS_DEFAULT_PROFILES_FILE é setado no docker-compose.yml (transmissor)
# No receptor, exporte manualmente apontando para config/fastdds_subscriber.xml
