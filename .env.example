# =========================
# Build arguments
# =========================
ARENASDK_ROOT_ON_HOST=./resources/ArenaSDK/linux64
ARENASDK_PARENT=/
ARENA_API_ROOT_ON_HOST=./resources/arena_api
ARENA_API_PARENT=/arena_api

# =========================
# Seriais das câmeras (override do cameras.yaml, sem recompilar)
# Edite aqui para trocar câmeras; use list_cameras.py para descobrir seriais
# =========================
CAMERA_1_SERIAL=
CAMERA_2_SERIAL=

# =========================
# Container/service defaults
# =========================
DISPLAY=:0
QT_X11_NO_MITSHM=1

# ROS2 / DDS
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ROS_SUPER_CLIENT=true
ROS_DISCOVERY_SERVER=

